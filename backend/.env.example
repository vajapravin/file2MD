# Backend Environment Variables
# Copy this file to .env and update values as needed.

# --- Application ---
APP_NAME=file2md
APP_VERSION=0.1.0
APP_ENV=development
APP_DEBUG=true
APP_LOG_LEVEL=INFO

# --- Server ---
HOST=0.0.0.0
PORT=8086

# --- Upload Limits ---
MAX_UPLOAD_SIZE_MB=60

# --- Conversion & Workers ---
CONVERSION_TIMEOUT_SECONDS=120
CHUNK_PARALLEL_WORKERS=4

# --- Redis ---
REDIS_URL=redis://redis:6379/0
JOB_TTL_SECONDS=3600

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8086,https://file2md.vajapravin.me
