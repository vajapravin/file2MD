# Backend Environment Variables
# Copy this file to .env and update values as needed.

# --- Application ---
APP_NAME=file2md
APP_VERSION=0.1.0
APP_ENV=development
APP_DEBUG=true
APP_LOG_LEVEL=INFO

# --- Server ---
HOST=0.0.0.0
PORT=8000

# --- Upload Limits ---
MAX_UPLOAD_SIZE_MB=50

# --- Conversion ---
CONVERSION_TIMEOUT_SECONDS=60

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5173
